# R session files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto build output — the site is rendered fresh by CI (or locally); never commit it
/.quarto/
/_site/
/_freeze/

# Pages generated at render time by the scripts/make_*.R pre-render scripts.
# They are rebuilt on every render; committing them only creates stale copies.
/bills-pages/
/senator-pages/
/lobby-pages/

# Per-document render artifacts Quarto sometimes leaves next to sources
*_files/

# Box Drive sync-conflict copies ("name (user@email).ext") — never track these
*(nbrouwer@ucmerced.edu)*

# Rendered HTML that a crashed render strands next to the sources (Quarto
# normally moves it into _site) — root level only; archive/ stays tracked
/*.html
/site_libs/

# Box also numbers repeat conflict copies: "name (user@email 2).ext"
*(nbrouwer@ucmerced.edu*
